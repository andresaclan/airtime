	"exportedAt": "2026-10-04T12:00:00.000Z",
	"about": "Jump timings marked by hand, frame by frame, on videos in Airtime. Each session is one video. Marks are the source data; everything under \"derived\", \"tables\" and \"overview\" is computed from them and can be recomputed. For analysis across sessions, start with \"tables\": flat rows that load directly into a dataframe or chart. Sessions are ordered by recordedAt, oldest first.",
	"fields": {
		"sessions[].marks[].seconds": "Media time of the mark in seconds (source of truth). Snapped to a frame boundary.",
		"sessions[].marks[].frame": "Frame index, derived as round(seconds × frameRate.value).",
		"sessions[].marks[].type": "\"takeoff\" = first frame the feet leave the ground; \"landing\" = first frame they touch down.",
		"sessions[].frameRate": "Frames per second used for frame math. source: \"container\" = read from the file, \"playback-estimate\" = measured during playback, \"default\" = assumed 30 fps (low trust).",
		"sessions[].timeScale": "Real seconds per media second. 1 = real-time footage; 0.25 = 4× slow motion.",
		"sessions[].derived.intervals[]": "Consecutive takeoff→landing pairs are \"flight\", landing→takeoff pairs are \"contact\". seconds = media time; realSeconds = seconds × timeScale.",
		"sessions[].derived.intervals[].heightCm": "Jump height from flight time, h = g·t²/8 with g = 9.81 m/s² and t = realSeconds. Assumes takeoff and landing at the same height.",
		"sessions[].derived.precisionMs": "Real-time duration of one frame; each mark is accurate to about ±1 frame.",
		"sessions[].derived.warnings[]": "\"out-of-sequence\" = this mark repeats the previous mark's type, so no interval was computed.",
		"tables.intervals[]": "One row per flight or contact interval across every session, with session context repeated on each row. index = 1-based position among intervals of the same kind within its session.",
		"tables.sessions[]": "One row per session with its summary statistics.",
		"recordedAt": "The video file's last-modified time: usually when it was recorded, but changed by some edits or copies.",
		"overview": "Totals and extremes across all exported sessions."
	},
