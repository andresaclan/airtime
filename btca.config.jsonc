{
  "$schema": "https://btca.dev/btca.schema.json",
  "providerTimeoutMs": 300000,
  "resources": [
    {
      "type": "git",
      "name": "svelte",
      "url": "https://github.com/sveltejs/svelte.dev",
      "branch": "main",
      "searchPath": "apps/svelte.dev/content",
      "specialNotes": "Svelte 5 docs. Focus on content directory for documentation on runes, components, and reactivity."
    },
    {
      "type": "git",
      "name": "svelteKit",
      "url": "https://github.com/sveltejs/svelte.dev",
      "branch": "main",
      "searchPath": "apps/svelte.dev/content/docs/kit",
      "specialNotes": "SvelteKit docs. Covers routing, load functions, hooks, adapters, and deployment."
    },
    {
      "type": "git",
      "name": "tailwindCss",
      "url": "https://github.com/tailwindlabs/tailwindcss.com",
      "branch": "main",
      "searchPath": "src/docs",
      "specialNotes": "Tailwind CSS v4 documentation. Covers utility classes, configuration, and theming."
    },
    {
      "type": "git",
      "name": "vite",
      "url": "https://github.com/vitejs/vite",
      "branch": "main",
      "searchPath": "docs",
      "specialNotes": "Vite bundler docs. Covers config, plugins, and build optimization."
    },
    {
      "type": "git",
      "name": "typescript",
      "url": "https://github.com/microsoft/TypeScript-Website",
      "branch": "v2",
      "searchPath": "packages/documentation/copy/en",
      "specialNotes": "TypeScript handbook and reference documentation."
    },
    {
      "type": "git",
      "name": "betterContext",
      "url": "https://github.com/davis7dotsh/better-context",
      "branch": "main"
    }
  ],
  "model": "claude-opus-4.5",
  "provider": "github-copilot"
}